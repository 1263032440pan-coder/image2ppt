# Keep this file in your local environment; NEVER commit the real key.
MOMA_API_KEY=
MOMA_API_URL=https://vip.moma.cmecloud.cn/v1/messages
MOMA_MODEL=deepseek-v4.1-flash-1017
# auto tries Anthropic image blocks, then OpenAI image_url parts on 4xx errors
MOMA_IMAGE_FORMAT=auto
MOMA_TIMEOUT_SECONDS=100
DEMO_MODE=false
MAX_ITERATIONS=3

# Object kinds for optional GrabCut source-instance traces. Failure falls back gracefully.
GEOMETRY_TRACE_KINDS=koi,lotus,pine,house,bridge,lily_pad,rock
# Continuous SVG gradient field, no color-grid cells. Band height 1-4 (larger = faster).
COLOR_BAND_HEIGHT=1
# Gradient x sampling distance 3-25 (smaller = finer).
COLOR_SAMPLE_STEP=6
# Max retained source-derived detail polylines. 200-7000.
DETAIL_MAX_PATHS=4800

# Extra traced lines are low-strength to avoid doubling ink already in the colour field.
DETAIL_OVERLAY_STRENGTH=0.20
